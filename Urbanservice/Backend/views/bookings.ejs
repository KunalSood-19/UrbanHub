<!DOCTYPE html>
<html>
<head>
<title>My Bookings - UrbanHub</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    margin: 0;
}

h1 {
    text-align: center;
    margin-top: 30px;
}

.container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 20px;
}

.card {
    background: white;
    padding: 20px;
    margin: 15px;
    border-radius: 10px;
    width: 260px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.card h3 {
    margin-bottom: 10px;
}

.empty {
    text-align: center;
    font-size: 18px;
    margin-top: 40px;
}
</style>

</head>

<body>

<h1>My Bookings</h1>

<div class="container">

<!-- If no bookings -->
<% if(bookings.length === 0){ %>
    <p class="empty">No bookings yet</p>
<% } %>

<!-- Loop through bookings -->
<% bookings.forEach(b => { %>

<div class="card">
    <h3><%= b.service %></h3>
    <p><b>Name:</b> <%= b.name %></p>
    <p><b>Email:</b> <%= b.email %></p>
    <p><b>Date:</b> <%= b.date %></p>
    <p><b>Time:</b> <%= b.time %></p>
</div>

<% }) %>

</div>

</body>
</html>